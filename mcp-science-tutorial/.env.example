# Copy to .env and fill in. Any OpenAI-compatible /v1/chat/completions endpoint works
# (OpenAI, Anthropic, OpenRouter, Groq, vLLM, Ollama, LiteLLM, ...).
# Generic names (preferred). Provider-specific names such as ANTHROPIC_API_KEY / GROQ_BASE_URL also work.
# N.B: Keep only one block of LLM_ variables in your .env file.
# For OPENROUTER, examples of how to specify the model are provided. e.g prodiver/model-name, or just model-name (OpenRouter will auto-detect the provider).

#OPENAI: https://api.openai.com/v1
LLM_API_KEY=sk-your-token-here 
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
MODEL=gpt-4o-mini

# ANTHROPIC: https://api.anthropic.com/v1
LLM_API_KEY=sk-your-token-here
LLM_BASE_URL="https://api.anthropic.com/v1/"
LLM_MODEL=claude-sonnet-5-5, claude-opus-5-5
MODEL=claude-sonnet-5-5

# OPENROUTER: https://openrouter.ai/api/v1
LLM_API_KEY=sk-your-token-here
LLM_BASE_URL="https://openrouter.ai/api/v1"
LLM_MODEL= openai/gpt-6-sol, anthropic/claude-opus-5.5, google/gemini-3.8-flash
MODEL=openai/gpt-6-sol, anthropic/claude-opus-5.5, google/gemini-3.8-flash